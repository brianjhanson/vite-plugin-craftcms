{
  "name": "vite-plugin-craftcms",
  "version": "4.0.0",
  "description": "Use Vite with Craft CMS. No Craft plugin necessary",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsdown",
    "check": "prettier . --check",
    "prepublishOnly": "npm run build",
    "release": "np",
    "prepare": "husky install"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.common.cjs"
      }
    }
  },
  "contributors": [
    {
      "name": "Brian Hanson",
      "email": "brian@brianhanson.net",
      "url": "https://www.brianhanson.net/"
    },
    {
      "name": "Chris Malven",
      "url": "https://malven.co/"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/brianjhanson/vite-plugin-craftcms",
    "directory": "src"
  },
  "bugs": {
    "url": "https://github.com/brianjhanson/vite-plugin-craftcms/issues"
  },
  "homepage": "https://github.com/brianjhanson/vite-plugin-craftcms#readme",
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "22.18.1",
    "husky": "9.1.7",
    "np": "11.0.2",
    "prettier": "3.8.1",
    "tsdown": "0.21.4",
    "typescript": "5.9.3",
    "vite": "8.0.1",
    "vitest": "4.1.0"
  },
  "dependencies": {
    "node-html-parser": "^6.1.13"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
